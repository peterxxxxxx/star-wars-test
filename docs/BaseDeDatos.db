/*
In Neon, databases are stored on branches. By default, a project has one branch and one database.
You can select the branch and database to use from the drop-down menus above.

Try generating sample data and querying it by running the example statements below, or click
New Query to clear the editor.
*/
-- Tabla principal de personajes
CREATE TABLE characters (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    birth_year VARCHAR(20),
    gender VARCHAR(20),
    height VARCHAR(10),
    mass VARCHAR(10),
    image_url TEXT, -- URL de Vercel Blob
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Tablas de catálogo
CREATE TABLE films (
    id SERIAL PRIMARY KEY,
    title VARCHAR(150) NOT NULL
);

CREATE TABLE vehicles (
    id SERIAL PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    model VARCHAR(150)
);

CREATE TABLE starships (
    id SERIAL PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    model VARCHAR(150)
);

-- Tablas intermedias (Relaciones Many-to-Many)
CREATE TABLE character_films (
    character_id INTEGER REFERENCES characters(id) ON DELETE CASCADE,
    film_id INTEGER REFERENCES films(id) ON DELETE CASCADE,
    PRIMARY KEY (character_id, film_id)
);

CREATE TABLE character_vehicles (
    character_id INTEGER REFERENCES characters(id) ON DELETE CASCADE,
    vehicle_id INTEGER REFERENCES vehicles(id) ON DELETE CASCADE,
    PRIMARY KEY (character_id, vehicle_id)
);

CREATE TABLE character_starships (
    character_id INTEGER REFERENCES characters(id) ON DELETE CASCADE,
    starship_id INTEGER REFERENCES starships(id) ON DELETE CASCADE,
    PRIMARY KEY (character_id, starship_id)
);
